rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'afa469382@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Game state: Public read to synchronize countdowns & draws across all devices
    // Only Admin can write or override forced outcomes
    match /game_state/{stateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Draw history: Public read so all devices share official historical results
    // Only Admin can record or correct draw results
    match /draw_history/{roundId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User accounts and balances
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if (isOwner(userId) && incoming().uid == request.auth.uid) || isAdmin();
    }

    // Bets collection: Players create bets, view their own; Admins monitor and settle
    match /bets/{betId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
